# GanttPro Configuration

# ── Firebase ──
# Create a Firebase project at https://console.firebase.google.com,
# enable Authentication (Google sign-in) and Firestore, then paste
# your web app's config values here.
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=1:YOUR_SENDER_ID:web:YOUR_APP_ID

# ── Admin email ──
# Your email address — grants you access to the admin panel and Firestore
# admin operations. After changing this value, run "npm run build:rules"
# to regenerate firestore.rules with your email.
VITE_ADMIN_EMAIL=you@example.com
